BACKEND_PORT=5050
FRONTEND_PORT=4200
COACH_PORT=4300

FRONTEND_CONTAINER_PORT=80
COACH_CONTAINER_PORT=80

BACKEND_HOST=localhost

FRONTEND_BACKEND_ORIGIN=

PASSKEY_RP_ID=localhost

MEDSIGN_HSM_PIN=

# Leave empty to sign with the key docker-compose.yml pins. Set it to an EC P-256
# private key (PKCS#8, base64) to use your own.
MEDSIGN_JWT_SIGNING_KEY=

# ---- Signing backend (presenter only) --------------------------------------
# Leave this alone. 'env' is the workshop. 'kms' swaps the whole signing layer
# for AWS KMS and needs credentials and a key that already exists.
#SIGNING_PROVIDER=hsm
#AWS_REGION=eu-west-1
#AWS_KMS_KEY_ID=
#KMS_ALLOW_KEY_CREATION=false
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
