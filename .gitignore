# Written by the backend on first run. Holds the JWT signing key in clear text.
backend/MedSign.Api/.env

# Build output. Produced inside the container, by Linux, for Linux -- your host
# has no .NET and never needs to look in here.
backend/**/bin/
backend/**/obj/
backend/artifacts/

# Left behind by a manual `dotnet test` run.
backend/TestResults/

# Written by the test gate for the coach dashboard on every build.
status/*
!status/.gitkeep

# The database, created on first run.
data/*
!data/.gitkeep
