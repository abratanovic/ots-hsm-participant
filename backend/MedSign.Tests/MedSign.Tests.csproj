<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- xUnit v3 test projects are executables, and the .NET 10 SDK runs them
         through Microsoft.Testing.Platform rather than the retired VSTest. -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- The gate reads the exit code, so a warning must never become an error
         here: a warning in the participant's own code should still let the
         tests run and report. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- v3, not v2: Assert.Skip is what lets an exercise nobody has started yet
         report as pending instead of failing and blocking the backend. -->
    <PackageReference Include="xunit.v3" Version="4.0.0" />

    <!-- Runs the real application in memory, so the endpoint exercises are
         tested over HTTP rather than by calling their handlers directly. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MedSign.Api/MedSign.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
