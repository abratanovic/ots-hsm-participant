<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exercise 1's WebAuthn verification. Fido2NetLib parses the attestation
         object, the COSE key and authenticatorData, and checks the signature;
         MedSign supplies the ceremony state and decides what to store. See
         ADR 0005. Fido2.AspNet is deliberately NOT referenced: IFido2 is
         registered by hand in Program.cs from the existing Passkey section, so
         there is one source of truth for the RP ID and the origins. -->
    <PackageReference Include="Fido2" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Pkcs11Interop" Version="5.3.0" />
    <!-- The report PDFs. Chosen for a fluent layout API over positioning boxes
         by coordinate, and for a licence that is not viral, which stopped
         mattering the moment embedded PAdES signatures went out of scope. Its
         licence flag is set in MedSignServices; without that it throws at the
         first render rather than at startup. -->
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Program is internal (top-level statements), and WebApplicationFactory
         needs to see it to boot the app in-process for the endpoint tests. -->
    <InternalsVisibleTo Include="MedSign.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core's implicit usings pull in Microsoft.AspNetCore.Http.ISession,
         which collides with the PKCS#11 one. Pin the name project-wide so no Lab
         file has to carry a disambiguating using. -->
    <Using Include="Net.Pkcs11Interop.HighLevelAPI.ISession" Alias="ISession" />
    <Using Include="Net.Pkcs11Interop.HighLevelAPI.Factories" />
  </ItemGroup>

</Project>
